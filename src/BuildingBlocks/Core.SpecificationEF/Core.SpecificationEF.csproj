<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core evaluators for Core.Specification (Include, tracking, split query, SQL LIKE search, query tags).</Description>
    <!-- Vendored fork of Ardalis.Specification: keep upstream code style so diffs against upstream stay readable. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Specification\Core.Specification.csproj" />
  </ItemGroup>

</Project>
